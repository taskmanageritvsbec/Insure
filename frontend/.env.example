# ── INSURE Frontend Environment Configuration ────────────────────────────────
# On Vercel multi-service deployment, frontend and backend share the same domain.
# VITE_API_BASE_URL defaults to /api automatically (no variable needed).
# Only set VITE_API_BASE_URL if deploying the frontend to a separate custom domain.
# VITE_API_BASE_URL=https://your-backend-api.onrender.com

# Optional: Override local dev proxy target (defaults to http://localhost:3001 or bound BACKEND_URL)
# VITE_API_PROXY_TARGET=http://localhost:3001
