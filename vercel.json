{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "insure-backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install && npm run build"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "insure-backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "insure-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
